<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>FtpSettingsDialogBase</class>
 <widget class="QDialog" name="FtpSettingsDialogBase">
  <property name="windowTitle">
   <string>Paramètres du serveur FTP cadastral</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">

   <item>
    <widget class="QLabel" name="labelInfo">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text">
      <string>Renseignez les informations de connexion au serveur FTP hébergeant la couche de parcelles cadastrales de référence. Ces informations sont enregistrées localement sur ce poste (non chiffrées).</string>
     </property>
    </widget>
   </item>

   <item>
    <layout class="QFormLayout" name="formLayout">
     <item row="0" column="0">
      <widget class="QLabel" name="labelHost">
       <property name="text"><string>Serveur (hôte) :</string></property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QLineEdit" name="mLineHost">
       <property name="placeholderText"><string>ex: 172.23.0.179</string></property>
      </widget>
     </item>

     <item row="1" column="0">
      <widget class="QLabel" name="labelPort">
       <property name="text"><string>Port :</string></property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QSpinBox" name="mSpinPort">
       <property name="minimum"><number>1</number></property>
       <property name="maximum"><number>65535</number></property>
       <property name="value"><number>21</number></property>
      </widget>
     </item>

     <item row="2" column="0">
      <widget class="QLabel" name="labelAuthConfig">
       <property name="text"><string>Identifiants (authentification QGIS) :</string></property>
      </widget>
     </item>
     <item row="2" column="1">
      <widget class="QgsAuthConfigSelect" name="mAuthConfigSelect" native="true"/>
     </item>

     <item row="3" column="0">
      <widget class="QLabel" name="labelChemin">
       <property name="text"><string>Chemin du fichier distant :</string></property>
      </widget>
     </item>
     <item row="3" column="1">
      <widget class="QLineEdit" name="mLineCheminDistant">
       <property name="placeholderText"><string>ex: /BDD SIG/Administratif/Cadastre/cadastre-974-parcelles.json</string></property>
      </widget>
     </item>
    </layout>
   </item>

   <item>
    <widget class="QLabel" name="labelAideAuth">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text">
      <string>Les identifiants sont enregistrés dans la base d'authentification chiffrée de QGIS (protégée par le mot de passe maître), et non dans le plugin. Cliquez sur "..." pour créer une nouvelle configuration de type "Basique" (nom d'utilisateur / mot de passe), ou laissez vide pour une connexion FTP anonyme.</string>
     </property>
    </widget>
   </item>

   <item>
    <widget class="QLabel" name="labelAide">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text">
      <string>Le fichier distant peut être un shapefile (.shp — ses fichiers annexes .shx/.dbf/.prj seront aussi récupérés) ou tout autre format lisible par QGIS en un seul fichier (GeoJSON, GeoPackage...).</string>
     </property>
    </widget>
   </item>

   <item>
    <layout class="QHBoxLayout" name="hboxTest">
     <item>
      <widget class="QPushButton" name="mButtonTester">
       <property name="text"><string>Tester la connexion</string></property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="mLabelResultatTest">
       <property name="wordWrap"><bool>true</bool></property>
       <property name="text"><string></string></property>
      </widget>
     </item>
    </layout>
   </item>

   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Save</set>
     </property>
    </widget>
   </item>

  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>QgsAuthConfigSelect</class>
   <extends>QWidget</extends>
   <header>qgis.gui</header>
  </customwidget>
 </customwidgets>
 <resources/>
 <connections/>
</ui>
